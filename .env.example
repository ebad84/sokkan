# GEMINI_API_KEY: Optional in this app; AI Studio injects if configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PANEL_ADMIN_PASSCODE: Optional admin passcode for the CI/CD panel.
# Leave empty on first run to claim an admin password via the setup UI.
PANEL_ADMIN_PASSCODE=

# DATA_DIR: Directory for SQLite database and cloned repositories.
DATA_DIR=

# DOCKER_HOST: Optional Docker socket path or TCP endpoint (defaults to /var/run/docker.sock).
DOCKER_HOST=

# DOCKER_NETWORK: Shared Docker bridge network used by Caddy and deployed apps (default: web).
DOCKER_NETWORK=web

# CADDYFILE_PATH: Path to the global Caddyfile on the VPS.
CADDYFILE_PATH=

# CADDY_ADMIN_URL: Caddy Admin API endpoint (defaults to http://127.0.0.1:2019).
CADDY_ADMIN_URL=
